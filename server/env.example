NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB — standard connection string (mongodb+srv:// may be blocked on some networks)
MONGO_URI=mongodb://localhost:27017/skillify

# JWT — use long, random, unique values in any real deployment
JWT_SECRET=replace_with_a_random_32plus_character_secret
JWT_REFRESH_SECRET=replace_with_a_different_random_32plus_character_secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Google OAuth (optional — only needed for "Sign in with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (optional — only needed for password reset / notification emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_NAME=Skillify
FROM_EMAIL=no-reply@skillify.com

# MCP server (optional — enables server-to-server auth for the /api/v1/mcp endpoint)
MCP_SECRET=
